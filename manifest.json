{
  "manifest_version": 3,
  "name": "Video Flip",
  "version": "1.0.0",
  "description": "Spiegelt Videos in Google Drive und YouTube per Klick horizontal. Flip Google Drive and YouTube videos horizontally.",
  "homepage_url": "https://github.com/maexware-danny/video-flip",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://drive.google.com/*",
        "https://youtube.googleapis.com/*",
        "https://www.youtube.com/*",
        "https://youtube.com/*",
        "https://m.youtube.com/*"
      ],
      "all_frames": true,
      "match_origin_as_fallback": true,
      "js": ["shadow-patch.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://drive.google.com/*",
        "https://youtube.googleapis.com/*",
        "https://www.youtube.com/*",
        "https://youtube.com/*",
        "https://m.youtube.com/*"
      ],
      "all_frames": true,
      "match_origin_as_fallback": true,
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
